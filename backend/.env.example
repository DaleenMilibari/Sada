# --- AI model -------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
YOUTUBE_API_KEY=
# --- Environment ----------------------------------------------------------
# "production" enforces the auth settings below at startup and hides /docs.
SADA_ENV=development

# Comma-separated list of frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# --- Auth -----------------------------------------------------------------
# Shared team password for the login screen. Leave empty locally to disable auth.
SADA_ACCESS_PASSWORD=
# Token signing key, >= 32 chars. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SADA_SECRET_KEY=
SADA_TOKEN_TTL_HOURS=12

# --- Rate limits (requests / minute / client IP) ----------------------------
SADA_LLM_RATE_LIMIT_PER_MINUTE=20
SADA_LOGIN_RATE_LIMIT_PER_MINUTE=5
# Reverse proxies appending to X-Forwarded-For (1 on Render, 0 locally).
SADA_TRUSTED_PROXY_HOPS=0

# --- Database ----------------------------------------------------------------
# Leave empty locally to use SQLite at backend/store/sada.db. Render sets this to its Postgres.
DATABASE_URL=

# --- Data Collector agent (YouTube) --------------------------------------------
YOUTUBE_API_KEY=
COLLECTOR_LOOKBACK_DAYS=60
COLLECTOR_MAX_VIDEOS_PER_CHANNEL=3000
# YouTube quota units per run (free daily quota: 10,000). 300 x 48 runs/day = 14,400 worst case,
# but steady-state runs spend far less once the window is backfilled.
COLLECTOR_QUOTA_PER_RUN=600
COLLECTOR_LLM_CLASSIFY_PER_RUN=400
# Keep false locally so --reload doesn't burn quota; run the CLI instead.
COLLECTOR_SCHEDULE_ENABLED=false
COLLECTOR_INTERVAL_MINUTES=30

# --- Data Collector agent (Instagram, Meta Graph API) ---------------------------
# Setup steps: DATA_COLLECTION.md section 3. Leave empty to collect YouTube only.
META_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
META_GRAPH_API_VERSION=v23.0
INSTAGRAM_REFRESH_DAYS=7
INSTAGRAM_MAX_PAGES_PER_ACCOUNT=10

# --- Data Collector agent (X API v2) ----------------------------------------------
# App-only bearer token from OUR developer account (console.x.com) - no SBA login needed.
# Pay-per-use: ~$0.005 per post read. Each post is read once; the budget below is a hard stop.
X_BEARER_TOKEN=
X_TOTAL_POST_BUDGET=6000
X_MAX_POSTS_PER_RUN=4000
X_MAX_POSTS_PER_ACCOUNT=600

# --- Audience analysis (comments / replies -> sentiment & intent) ------------------
# YouTube comment threads for this many recent videos per account per run (1 quota unit each).
AUDIENCE_YT_VIDEOS_PER_RUN=3
AUDIENCE_YT_COMMENTS_PER_VIDEO=100
# X replies are billed like posts (~$0.005 each); hard cap across all runs. 0 disables.
X_REPLY_BUDGET=1000
AUDIENCE_X_POSTS_PER_RUN=10  # per account
X_REPLIES_PER_POST=20
# Comments classified by Gemini per run (batches of 50 = 1 request each). 0 disables.
AUDIENCE_LLM_CLASSIFY_PER_RUN=200
