# --- AI model -------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Environment ----------------------------------------------------------
# "production" enforces the auth settings below at startup and hides /docs.
SADA_ENV=development

# Comma-separated list of frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# --- Auth -----------------------------------------------------------------
# Shared team password for the login screen. Leave empty locally to disable auth.
SADA_ACCESS_PASSWORD=
# Token signing key, >= 32 chars. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SADA_SECRET_KEY=
SADA_TOKEN_TTL_HOURS=12

# --- Rate limits (requests / minute / client IP) ----------------------------
SADA_LLM_RATE_LIMIT_PER_MINUTE=20
SADA_LOGIN_RATE_LIMIT_PER_MINUTE=5
# Reverse proxies appending to X-Forwarded-For (1 on Render, 0 locally).
SADA_TRUSTED_PROXY_HOPS=0
